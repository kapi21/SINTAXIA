10 REM SINTAXIA - cliente CPC + M4
20 REM Host PC: cambia P$ si muda la IP
30 P$="192.168.1.4:8080"
40 S=0:E=0:OK=0:INTRO=0
50 ON ERROR GOTO 8000
60 GOSUB 7000:REM paleta
62 GOSUB 9200:REM envolventes AY
65 INTRO=1
70 GOSUB 7100:REM intro + ping
75 INTRO=0
80 REM --- bucle principal ---
100 PEN 1
110 INPUT ">",M$
120 IF M$="" THEN 100
130 IF M$="QUIT" OR M$="quit" OR M$="Quit" THEN 8500
140 IF M$="AYUDA" OR M$="ayuda" OR M$="Ayuda" THEN GOSUB 7700:GOTO 100
150 IF M$="NUEVA" OR M$="nueva" OR M$="Nueva" THEN GOSUB 7800:GOTO 100
160 GOSUB 1000:REM encode -> U$
170 A$="@"+P$+"/turn?msg="+U$+">RESP.TXT"
180 IF LEN(A$)>240 THEN PEN 3:PRINT "Msg muy largo":GOTO 100
190 PEN 2:PRINT "Esperando al maestro...":PEN 1
200 |HTTPGET,@A$
210 GOSUB 2000:REM leer RESP.TXT
220 GOSUB 9100:REM borde segun S
230 GOSUB 3000:REM mostrar T$
240 GOSUB 9000:REM sonido
250 GOTO 100
1000 REM --- encode espacio->+ ---
1010 U$=""
1020 FOR I=1 TO LEN(M$)
1030 C$=MID$(M$,I,1)
1040 IF C$=" " THEN C$="+"
1050 IF C$="&" OR C$="?" OR C$="#" THEN 1080
1060 IF C$=">" OR C$="@" OR C$="|" THEN 1080
1070 U$=U$+C$
1080 NEXT
1090 IF LEN(U$)>80 THEN U$=LEFT$(U$,80)
1100 RETURN
2000 REM --- lee paquete RESP.TXT ---
2010 T$="":S=0:E=1
2020 OPENIN "RESP.TXT"
2030 IF EOF THEN 2090
2040 LINE INPUT #9,L$
2050 IF LEFT$(L$,2)="T:" OR LEFT$(L$,2)="t:" THEN T$=MID$(L$,3):GOSUB 2200
2060 IF LEFT$(L$,2)="S:" OR LEFT$(L$,2)="s:" THEN S=VAL(MID$(L$,3))
2070 IF LEFT$(L$,2)="E:" OR LEFT$(L$,2)="e:" THEN E=VAL(MID$(L$,3))
2080 GOTO 2030
2090 CLOSEIN
2100 IF T$="" THEN T$="Sin respuesta":E=1
2110 IF S<0 THEN S=0
2120 IF S>5 THEN S=5
2130 RETURN
2200 REM --- LF/CR embebidos en T$ ---
2210 K=INSTR(T$,CHR$(10))
2220 IF K=0 THEN K=INSTR(T$,CHR$(13))
2230 IF K=0 THEN RETURN
2240 R$=MID$(T$,K+1)
2250 T$=LEFT$(T$,K-1)
2260 IF RIGHT$(T$,1)=CHR$(13) THEN T$=LEFT$(T$,LEN(T$)-1)
2270 IF RIGHT$(T$,1)=CHR$(10) THEN T$=LEFT$(T$,LEN(T$)-1)
2280 GOSUB 2300
2290 RETURN
2300 REM --- S:/E: dentro de R$ ---
2310 IF R$="" THEN RETURN
2320 IF LEFT$(R$,1)=CHR$(10) OR LEFT$(R$,1)=CHR$(13) THEN R$=MID$(R$,2):GOTO 2310
2330 IF LEFT$(R$,2)="S:" OR LEFT$(R$,2)="s:" THEN S=VAL(MID$(R$,3))
2340 IF LEFT$(R$,2)="E:" OR LEFT$(R$,2)="e:" THEN E=VAL(MID$(R$,3))
2350 K=INSTR(R$,CHR$(10))
2360 IF K=0 THEN K=INSTR(R$,CHR$(13))
2370 IF K=0 THEN RETURN
2380 R$=MID$(R$,K+1)
2390 GOTO 2310
3000 REM --- imprime T$ por | ---
3010 IF E<>0 THEN PEN 3:PRINT "ERROR:":PEN 1
3020 P=1
3030 IF P>LEN(T$) THEN PRINT:RETURN
3040 J=INSTR(P,T$,"|")
3050 IF J=0 THEN PRINT MID$(T$,P):PRINT:RETURN
3060 PRINT MID$(T$,P,J-P)
3070 P=J+1
3080 GOTO 3030
7000 REM --- paleta monitor retro MODE 1 ---
7010 MODE 1
7020 BORDER 0
7030 INK 0,0
7040 INK 1,15
7050 INK 2,26
7060 INK 3,6
7070 PAPER 0:PEN 1:CLS
7080 RETURN
7100 REM --- pantalla de introduccion ---
7110 CLS
7120 PEN 2:PRINT "======= SINTAXIA =======":PEN 1
7130 PRINT "Aventura conversacional con IA"
7140 PRINT "Amstrad CPC + M4 Board"
7150 PRINT
7160 PRINT "Escribe en espanol lo que haces."
7170 PRINT "Un maestro (IA en el PC) narra"
7180 PRINT "la historia y manda efectos AY."
7190 PRINT
7200 PEN 2:PRINT "Comandos:":PEN 1
7210 PRINT " AYUDA  - esta ayuda"
7220 PRINT " NUEVA  - reinicia partida"
7225 PRINT " INV    - ver inventario"
7230 PRINT " QUIT   - salir"
7240 PRINT
7250 PEN 2:PRINT "Comprobando servidor...":PEN 1
7260 GOSUB 7500
7270 PRINT
7280 IF OK=1 THEN 7400
7290 PEN 3:PRINT "*** SERVIDOR NO ACTIVO ***":PEN 1
7300 PRINT "En el PC, misma WiFi:"
7310 PRINT "  run_server.bat"
7320 PRINT "IP esperada: ";P$
7330 PRINT
7340 PRINT "Pulsa R para reintentar"
7350 PRINT "o ESPACIO para seguir igual."
7360 K$=INKEY$:IF K$="" THEN 7360
7370 IF K$="r" OR K$="R" THEN 7250
7380 PEN 3:PRINT "Sigues SIN servidor.":PEN 1
7390 GOTO 7450
7400 PEN 2:PRINT "*** SERVIDOR ACTIVO ***":PEN 1
7410 PRINT "Todo listo."
7420 PRINT
7430 PRINT "Ejemplo: miro alrededor"
7440 PRINT "Luego escribe tu accion."
7450 PRINT
7460 PEN 2:PRINT "-- La aventura comienza --":PEN 1
7470 PRINT
7480 RETURN
7500 REM --- ping HTTP /ping ---
7510 OK=0:E=1:T$=""
7520 A$="@"+P$+"/ping>PING.TXT"
7530 |HTTPGET,@A$
7540 OPENIN "PING.TXT"
7550 IF EOF THEN 7600
7560 LINE INPUT #9,L$
7570 IF LEFT$(L$,2)="T:" OR LEFT$(L$,2)="t:" THEN T$=MID$(L$,3):GOSUB 2200
7580 IF LEFT$(L$,2)="E:" OR LEFT$(L$,2)="e:" THEN E=VAL(MID$(L$,3))
7590 GOTO 7550
7600 CLOSEIN
7610 IF E<>0 THEN RETURN
7620 IF INSTR(T$,"OK")>0 THEN OK=1
7630 IF INSTR(T$,"ok")>0 THEN OK=1
7640 IF INSTR(T$,"servidor")>0 THEN OK=1
7650 RETURN
7700 REM --- ayuda in-game ---
7710 PRINT
7720 PEN 2:PRINT "SINTAXIA - ayuda":PEN 1
7730 PRINT "Escribe acciones libres:"
7740 PRINT " miro alrededor, voy al norte..."
7745 PRINT " INV / inventario - objetos"
7750 PRINT " AYUDA / NUEVA / QUIT"
7760 PRINT "Servidor PC: ";P$
7770 IF OK=1 THEN PRINT "Estado: activo" ELSE PRINT "Estado: dudoso"
7780 PRINT
7790 RETURN
7800 REM --- nueva partida /reset ---
7810 PEN 2:PRINT "Nueva partida...":PEN 1
7820 A$="@"+P$+"/reset>RESP.TXT"
7830 |HTTPGET,@A$
7840 GOSUB 2000
7850 S=0:GOSUB 9100
7860 GOSUB 3000
7870 GOSUB 9000
7880 RETURN
8000 REM --- error handler ---
8010 PEN 3:PRINT "Fallo red/archivo.":PEN 1
8020 PRINT "Revisa run_server.bat en el PC."
8030 CLOSEIN
8040 OK=0
8050 IF INTRO=1 THEN RESUME 7280
8060 RESUME 100
8500 PEN 2:PRINT "Hasta pronto, aventurero.":PEN 1
8510 BORDER 0
8520 END
9000 REM --- efectos AY S=0..5 (ENV/ENT) ---
9010 IF S=0 THEN RETURN
9020 IF S=1 THEN SOUND 1,520,45,14,1,0,1:RETURN
9030 IF S=2 THEN SOUND 1,300,70,10,2,0,2:SOUND 2,450,70,6,2,0,2:RETURN
9040 IF S=3 THEN SOUND 1,110,10,0,3,0,3:SOUND 1,85,10,0,3,0,3:SOUND 1,55,16,0,3,0,3:RETURN
9050 IF S=4 THEN SOUND 1,900,6,15,4,22,4:SOUND 1,700,12,12,4,12,0:RETURN
9060 IF S=5 THEN SOUND 1,160,12,0,5,0,5:SOUND 1,120,12,0,5,0,5:SOUND 1,80,22,0,5,0,5:RETURN
9070 RETURN
9100 REM --- borde segun codigo S ---
9110 IF S=0 THEN BORDER 0
9120 IF S=1 THEN BORDER 3
9130 IF S=2 THEN BORDER 1
9140 IF S=3 THEN BORDER 12
9150 IF S=4 THEN BORDER 6
9160 IF S=5 THEN BORDER 18
9170 RETURN
9200 REM --- define envolventes volumen/tono ---
9210 ENV 1,1,14,1,12,-1,2
9220 ENT 1,10,4,2,10,-4,2
9230 ENV 2,8,1,2,12,-1,3
9240 ENT 2,25,2,4,25,-2,4
9250 ENV 3,1,13,1,6,-2,1
9260 ENT 3,3,-12,1,3,12,1,3,-12,1
9270 ENV 4,1,15,1,3,-4,1
9280 ENT 4,3,25,1,4,-35,1
9290 ENV 5,1,12,1,4,1,1,10,-1,2
9300 ENT 5,5,-8,1,5,-8,1,5,-8,1
9310 RETURN
