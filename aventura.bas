10 REM AVENTURA IA M4 - FASE 2/3
20 REM PC=192.168.1.4:8080  M4 HTTP
30 MODE 1
40 PRINT "AVENTURA IA / M4 BOARD"
50 PRINT "Escribe QUIT para salir"
60 PRINT
70 S=0:E=0
80 ON ERROR GOTO 8000
90 REM --- bucle principal ---
100 INPUT ">",M$
110 IF M$="" THEN 100
120 IF M$="QUIT" OR M$="quit" OR M$="Quit" THEN 8500
130 GOSUB 1000:REM encode -> U$
140 REM URL silenciosa a RESP.TXT
150 A$="@192.168.1.4:8080/turn?msg="+U$+">RESP.TXT"
160 IF LEN(A$)>240 THEN PRINT "Msg muy largo":GOTO 100
170 PRINT "Esperando..."
180 |HTTPGET,@A$
190 GOSUB 2000:REM leer RESP.TXT
200 GOSUB 3000:REM mostrar T$
210 GOSUB 9000:REM sonido S
220 GOTO 100
1000 REM --- encode espacio->+ y limpia ---
1010 U$=""
1020 FOR I=1 TO LEN(M$)
1030 C$=MID$(M$,I,1)
1040 IF C$=" " THEN C$="+"
1050 IF C$="&" OR C$="?" OR C$="#" THEN 1080
1060 IF C$=">" OR C$="@" OR C$="|" THEN 1080
1070 U$=U$+C$
1080 NEXT
1090 IF LEN(U$)>80 THEN U$=LEFT$(U$,80)
1100 RETURN
2000 REM --- lee paquete RESP.TXT ---
2010 T$="":S=0:E=1
2020 OPENIN "RESP.TXT"
2030 IF EOF THEN 2090
2040 LINE INPUT #9,L$
2050 IF LEFT$(L$,2)="T:" OR LEFT$(L$,2)="t:" THEN T$=MID$(L$,3):GOSUB 2200
2060 IF LEFT$(L$,2)="S:" OR LEFT$(L$,2)="s:" THEN S=VAL(MID$(L$,3))
2070 IF LEFT$(L$,2)="E:" OR LEFT$(L$,2)="e:" THEN E=VAL(MID$(L$,3))
2080 GOTO 2030
2090 CLOSEIN
2100 IF T$="" THEN T$="Sin respuesta":E=1
2110 IF S<0 THEN S=0
2120 IF S>5 THEN S=5
2130 RETURN
2200 REM --- si T$ trae LF/CR embebidos, extrae S/E ---
2210 K=INSTR(T$,CHR$(10))
2220 IF K=0 THEN K=INSTR(T$,CHR$(13))
2230 IF K=0 THEN RETURN
2240 R$=MID$(T$,K+1)
2250 T$=LEFT$(T$,K-1)
2260 IF RIGHT$(T$,1)=CHR$(13) THEN T$=LEFT$(T$,LEN(T$)-1)
2270 IF RIGHT$(T$,1)=CHR$(10) THEN T$=LEFT$(T$,LEN(T$)-1)
2280 GOSUB 2300
2290 RETURN
2300 REM --- parsea R$ buscando S: y E: ---
2310 IF R$="" THEN RETURN
2320 IF LEFT$(R$,1)=CHR$(10) OR LEFT$(R$,1)=CHR$(13) THEN R$=MID$(R$,2):GOTO 2310
2330 IF LEFT$(R$,2)="S:" OR LEFT$(R$,2)="s:" THEN S=VAL(MID$(R$,3))
2340 IF LEFT$(R$,2)="E:" OR LEFT$(R$,2)="e:" THEN E=VAL(MID$(R$,3))
2350 K=INSTR(R$,CHR$(10))
2360 IF K=0 THEN K=INSTR(R$,CHR$(13))
2370 IF K=0 THEN RETURN
2380 R$=MID$(R$,K+1)
2390 GOTO 2310
3000 REM --- imprime lineas T$ separadas por | ---
3010 IF E<>0 THEN PRINT "ERROR:"
3020 P=1
3030 IF P>LEN(T$) THEN PRINT:RETURN
3040 J=INSTR(P,T$,"|")
3050 IF J=0 THEN PRINT MID$(T$,P):PRINT:RETURN
3060 PRINT MID$(T$,P,J-P)
3070 P=J+1
3080 GOTO 3030
8000 REM --- error handler ---
8010 PRINT "Fallo red/archivo. Revisa servidor."
8020 CLOSEIN
8030 RESUME 100
8500 PRINT "Adios."
8510 END
9000 REM --- efectos AY S=0..5 ---
9010 IF S=0 THEN RETURN
9020 IF S=1 THEN SOUND 1,450,25,15:RETURN
9030 IF S=2 THEN SOUND 1,220,35,10:SOUND 1,280,35,8:RETURN
9040 IF S=3 THEN SOUND 1,90,8,12:SOUND 1,70,8,12:SOUND 1,50,14,14:RETURN
9050 IF S=4 THEN SOUND 1,700,6,15:SOUND 1,850,10,12:RETURN
9060 IF S=5 THEN SOUND 1,140,10,12:SOUND 1,100,10,12:SOUND 1,70,18,15:RETURN
9070 RETURN
